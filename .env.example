# Kiwiw AI & stock keys. Copy to ".env" and fill in to go from demo → live.
# NOTE: Vite exposes VITE_* vars to the browser. Fine for local prototyping;
# for production, proxy these calls through your own backend instead.

# OpenAI — powers Magic Write (text) and Magic Media (images)
VITE_OPENAI_API_KEY=

# remove.bg — powers Background Remover (optional; a naive fallback runs without it)
VITE_REMOVEBG_API_KEY=

# Pexels — real stock photo search (optional; demo photos load without it)
VITE_PEXELS_API_KEY=
